# Copy to .env and fill in. See README.md for how to get each value.

# Path to the service account JSON key you downloaded from Google Cloud.
GOOGLE_SERVICE_ACCOUNT_JSON=./service_account.json

# Drive folder ID that you shared with the service account email.
# From the folder URL: https://drive.google.com/drive/folders/<THIS_PART>
HSA_DRIVE_FOLDER_ID=

# Google Sheet ID that you shared with the service account email.
# From the sheet URL: https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
HSA_SHEET_ID=

# Anthropic API key for receipt vision extraction.
# Leave blank to run fully manual — uploads still work, extraction is skipped.
ANTHROPIC_API_KEY=

# Model used for extraction. Must support vision + structured outputs.
ANTHROPIC_MODEL=claude-opus-5

# Defaults for new receipts
HSA_DEFAULT_PAYMENT_METHOD=out_of_pocket
HSA_DEFAULT_PATIENT=self

# Dashboard projection + contribution tracking
HSA_PROJECTION_RATE=0.07
HSA_IRS_LIMIT=4400
HSA_IRS_LIMIT_YEAR=2026

# Local state (cache + audit log). Defaults to ~/.hsavault
# HSA_STATE_DIR=/Users/you/.hsavault
