# Copy to .env and fill in. See README.md for how to get each value.

# Path to your Google credentials JSON. Normally the OAuth client file you
# downloaded from Credentials -> OAuth client IDs. A service account key also
# works, but only on Workspace accounts writing to a Shared Drive.
GOOGLE_CREDENTIALS_JSON=./credentials.json

# Drive folder ID. From the folder URL:
# https://drive.google.com/drive/folders/<THIS_PART>
HSA_DRIVE_FOLDER_ID=

# Google Sheet ID. Leave blank and bootstrap_sheet.py --create makes it for you.
# From the sheet URL: https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
HSA_SHEET_ID=

# NVIDIA API key for receipt vision extraction (starts with nvapi-).
# Get one at https://build.nvidia.com — click any model, then "Get API Key".
# Leave blank to run fully manual — uploads still work, extraction is skipped.
NVIDIA_API_KEY=

# Any NVIDIA NIM vision model. Free-endpoint options include
# meta/llama-3.2-90b-vision-instruct, meta/llama-3.2-11b-vision-instruct,
# nvidia/nemotron-nano-12b-v2-vl, nvidia/llama-3.1-nemotron-nano-vl-8b-v1
NVIDIA_MODEL=meta/llama-3.2-90b-vision-instruct

# OpenAI-compatible endpoint. Change only for a self-hosted NIM container.
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Defaults for new receipts
HSA_DEFAULT_PAYMENT_METHOD=out_of_pocket
HSA_DEFAULT_PATIENT=self

# Dashboard projection + contribution tracking
HSA_PROJECTION_RATE=0.07
HSA_IRS_LIMIT=4400
HSA_IRS_LIMIT_YEAR=2026

# Local state (cache + audit log). Defaults to ~/.hsavault
# HSA_STATE_DIR=/Users/you/.hsavault
